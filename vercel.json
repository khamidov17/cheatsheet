{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node",
            "config": {
                "maxDuration": 60
            }
        }
    ],
    "rewrites": [
        {
            "source": "/((?!_vercel/.*).*)",
            "destination": "/server.js"
        }
    ]
}